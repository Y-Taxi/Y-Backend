<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.login.mapper.LoginMapper">

    <select id="selectLoginCnt" parameterType="com.example.ytaxi.develop.login.dto.LoginDto" resultType="int">
        SELECT COUNT(*)
          FROM TBL_LOGIN A
         WHERE A.LOGIN_ID = #{loginId}
           AND A.PW = #{pw}
    </select>

</mapper>